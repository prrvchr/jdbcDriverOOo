<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="Replicator" dlg:page="1" dlg:left="0" dlg:top="0" dlg:width="250" dlg:height="100" dlg:help-text="&amp;Replicator.HelpText" dlg:closeable="false" dlg:moveable="false" dlg:title="&amp;Replicator.Title" dlg:withtitlebar="false">
  <dlg:styles>
    <dlg:style dlg:style-id="0" dlg:font-weight="150"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:text dlg:style-id="0" dlg:id="Label1" dlg:tab-index="0" dlg:left="10" dlg:top="5" dlg:width="65" dlg:height="15" dlg:help-text="&amp;Replicator.Label1.HelpText" dlg:value="&amp;Replicator.Label1.Label" dlg:valign="center"/>
    <dlg:button dlg:id="CommandButton1" dlg:page="2" dlg:tab-index="1" dlg:left="100" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;Replicator.CommandButton1.HelpText" dlg:value="&amp;Replicator.CommandButton1.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ClearLog" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="CommandButton2" dlg:tab-index="2" dlg:left="150" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;Replicator.CommandButton2.HelpText" dlg:value="&amp;Replicator.CommandButton2.Label.0" dlg:toggled="1">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowLog" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="CommandButton3" dlg:tab-index="3" dlg:left="200" dlg:top="5" dlg:width="45" dlg:height="15" dlg:help-text="&amp;Replicator.CommandButton3.HelpText" dlg:value="&amp;Replicator.CommandButton3.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:CloseReplicator" script:language="UNO"/>
    </dlg:button>
    <dlg:textfield dlg:id="TextField1" dlg:page="2" dlg:tab-index="4" dlg:left="5" dlg:top="25" dlg:width="240" dlg:height="70" dlg:help-text="&amp;Replicator.TextField1.HelpText" dlg:hscroll="true" dlg:vscroll="true" dlg:multiline="true" dlg:readonly="true" dlg:value="&amp;Replicator.TextField1.Text"/>
  </dlg:bulletinboard>
</dlg:window>

